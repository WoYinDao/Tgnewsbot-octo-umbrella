# ====================================
# Telegram 新闻播报机器人配置示例
# ====================================
# 使用说明：
# 1. 复制本文件为 .env
# 2. 填写所有必需的配置项
# 3. 不要将 .env 提交到 git

# ====================================
# Telethon 采集端配置（必需）
# ====================================
# 如何获取：https://my.telegram.org/apps
TELETHON_API_ID=your_api_id_here
TELETHON_API_HASH=your_api_hash_here

# Session 文件名（首次运行会自动生成）
TELETHON_SESSION=tg_news_session

# 首次登录需要的手机号（带国家码，如 +886912345678）
# 首次运行后可以留空
TELETHON_PHONE=+886912345678

# ====================================
# 采集源配置（必需）
# ====================================
# 格式：用逗号分隔的频道 username 或 ID
# 示例：SOURCE_CHANNELS=@channel1,@channel2,-1001234567890
SOURCE_CHANNELS=@example_channel1,@example_channel2

# 每次采集最多拉取的消息数
FETCH_LIMIT=50

# 采集间隔（分钟）
FETCH_INTERVAL_MINUTES=10

# ====================================
# Telegram Bot 发布端配置（必需）
# ====================================
# 如何创建 Bot：https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 目标频道 ID（格式：-1001234567890）
# 如何获取：见 README.md
TARGET_CHAT_ID=-1001234567890

# ====================================
# AI 分类配置（可选但推荐）
# ====================================
# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-key-here

# OpenAI Base URL（可选，默认为官方地址）
# 如果使用第三方代理或兼容 API，修改此项
OPENAI_BASE_URL=https://api.openai.com/v1

# 使用的模型（openai 0.10.5 兼容的模型）
# 注意：当前版本使用 Completion API，支持 text-davinci-003, text-curie-001 等
OPENAI_MODEL=text-davinci-003

# AI 分类置信度阈值（0-1）
# 只有置信度 >= 此值的消息才会作为快讯发布
AI_CONFIDENCE_THRESHOLD=0.7

# ====================================
# 日报配置
# ====================================
# 日报发布时间（24小时制，格式：HH:MM）
DAILY_REPORT_TIME=21:00

# 日报时区
DAILY_REPORT_TIMEZONE=Asia/Taipei

# 每个分类取 top N 条
DAILY_REPORT_TOP_N=10

# ====================================
# 其他配置
# ====================================
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# 消息最大长度（Telegram 限制 4096，建议 4000）
MESSAGE_MAX_LENGTH=4000
