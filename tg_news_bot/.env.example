# ====================================
# Telegram 新闻播报机器人配置示例
# ====================================
# 使用说明：
# 1. 复制本文件为 .env
# 2. 填写所有必需的配置项
# 3. 不要将 .env 提交到 git

# ====================================
# Telethon 采集端配置（必需）
# ====================================
# 如何获取：https://my.telegram.org/apps
TELETHON_API_ID=your_api_id_here
TELETHON_API_HASH=your_api_hash_here

# Session 文件名（首次运行会自动生成）
TELETHON_SESSION=tg_news_session

# 首次登录需要的手机号（带国家码，如 +886912345678）
# 首次运行后可以留空
TELETHON_PHONE=+886912345678

# ====================================
# 采集源配置（必需）
# ====================================
# 格式：用逗号分隔的频道 username 或 ID
# 示例：SOURCE_CHANNELS=@channel1,@channel2,-1001234567890
SOURCE_CHANNELS=@example_channel1,@example_channel2

# 每次采集最多拉取的消息数
FETCH_LIMIT=50

# 采集间隔（分钟）
FETCH_INTERVAL_MINUTES=10

# ====================================
# Telegram Bot 发布端配置（必需）
# ====================================
# 如何创建 Bot：https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 目标频道 ID（格式：-1001234567890）
# 如何获取：见 README.md
TARGET_CHAT_ID=-1001234567890

# ====================================
# AI 分类配置（可选但推荐，两种后端二选一）
# ====================================
# --- 后端一：Cursor SDK（优先级更高）---
# 使用 Cursor 订阅的模型做分类
# 获取 Key：https://cursor.com/dashboard/api
# CURSOR_API_KEY=your-cursor-api-key
# CURSOR_MODEL=composer-2.5

# --- 后端二：OpenAI 或任何 OpenAI 兼容 API ---
# 支持 OpenAI / DeepSeek / OpenRouter / 本地 Ollama 等
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# AI 分类置信度阈值（0-1）
# 只有置信度 >= 此值的消息才会作为快讯发布
AI_CONFIDENCE_THRESHOLD=0.7

# ====================================
# 日报配置
# ====================================
# 日报发布时间（24小时制，格式：HH:MM）
DAILY_REPORT_TIME=21:00

# 日报时区
DAILY_REPORT_TIMEZONE=Asia/Taipei

# 每个分类取 top N 条
DAILY_REPORT_TOP_N=10

# ====================================
# 快讯限流配置（防刷屏）
# ====================================
# 每轮采集后最多推送几条快讯
BREAKING_MAX_PER_ROUND=5

# 只推送入库时间在最近 N 小时内的消息
# 首次运行/长时间停机后积压的旧闻不会当快讯轰炸频道（仍会进日报）
BREAKING_MAX_AGE_HOURS=6

# AI 新闻价值分门槛（0-10）：AI 会给每条消息打“值不值得推送”的分，
# 低于门槛的不发快讯（仍进日报）；0 = 不限制；未打分的消息（纯规则分类）不受此限制
BREAKING_MIN_SCORE=6

# ====================================
# 语义去重配置（识别同一事件的相似报道）
# ====================================
# 是否启用（精确重复始终会被过滤，这里控制“相似但不相同”的判定）
SEMANTIC_DEDUP_ENABLED=true

# 后端：ngram = 本地相似度算法（免费，默认）
#       embedding = OpenAI 兼容向量接口（更准，需 OPENAI_API_KEY，费用极低）
SEMANTIC_DEDUP_BACKEND=ngram

# 判重阈值（留空按后端默认：ngram 0.55 / embedding 0.90）
# SEMANTIC_DEDUP_THRESHOLD=

# 只和最近 N 小时内的消息比对
SEMANTIC_DEDUP_WINDOW_HOURS=48

# embedding 后端使用的向量模型
# EMBEDDING_MODEL=text-embedding-3-small

# ====================================
# Bot 管理命令（可选但推荐）
# ====================================
# 允许使用管理命令的 Telegram 用户 ID（逗号分隔，留空 = 禁用命令功能）
# 获取自己的 ID：在 Telegram 里给 @userinfobot 发条消息
# 配置后私聊机器人发 /help 查看全部命令（/stats /addsource /threshold /pause /report 等）
# ADMIN_USER_IDS=123456789

# ====================================
# 数据保留配置
# ====================================
# 消息在本地数据库保留的天数，超期自动清理（0 = 永久保留）
DB_RETENTION_DAYS=30

# ====================================
# 其他配置
# ====================================
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# 消息最大长度（Telegram 限制 4096，建议 4000）
MESSAGE_MAX_LENGTH=4000
